# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plans
*.tfplan
tfplan
plan.out

# Terraform variable files containing sensitive values
*.auto.tfvars
*.auto.tfvars.json

# Crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Generated lock files are normally committed
# Do not ignore .terraform.lock.hcl

# IDE files
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak